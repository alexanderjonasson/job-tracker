generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id        Int       @id @default(autoincrement())
  company   String
  role      String
  url       String?
  status    JobStatus @default(APPLIED)
  notes     String?
  appliedAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum JobStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}